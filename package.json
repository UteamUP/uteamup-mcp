  "repository": {
    "type": "git",
    "url": "git+https://github.com/uteamup/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/uteamup/mcp-server/issues"
  },
  "homepage": "https://github.com/uteamup/mcp-server#readme",
  "scripts": {

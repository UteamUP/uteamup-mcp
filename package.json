    "test:watch": "jest --watch",
    "test:integration": "jest test/integration.test.js",
    "lint": "eslint index.js test/",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "jest": "^29.7.0",

{
  "name": "uteamup",
  "displayName": "UteamUP CMMS",
  "version": "2.3.0-beta.9",
  "description": "Connect Claude Code to UteamUP CMMS for work orders, assets, maintenance, inventory, and operations via Model Context Protocol (MCP).",
  "author": {
    "name": "UteamUP",
    "email": "gisli@uteamup.com",
    "url": "https://uteamup.com"
  },
  "homepage": "https://uteamup.com",
  "repository": "https://github.com/UteamUP/uteamup-mcp",
  "license": "MIT",
  "icon": "./assets/logo.png",
  "documentationUrl": "https://github.com/UteamUP/uteamup-mcp/blob/main/plugins/claude/README.txt",
  "supportUrl": "https://github.com/UteamUP/uteamup-mcp/issues",
  "privacyPolicyUrl": "https://app.uteamup.com/privacypolicy",
  "termsOfServiceUrl": "https://app.uteamup.com/terms",
  "keywords": [
    "mcp",
    "uteamup",
    "cmms",
    "maintenance",
    "work-orders",
    "asset-management"
  ],
  "mcpServers": "./.mcp.json",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "UteamUP API key",
      "description": "Your 32-character MCP-enabled UteamUP tenant API key",
      "sensitive": true,
      "required": true
    },
    "api_secret": {
      "type": "string",
      "title": "UteamUP API secret",
      "description": "Your UteamUP tenant API key secret",
      "sensitive": true,
      "required": true
    }
  }
}
